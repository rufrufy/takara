  "narrative": {
    "northStar": "Catatan Harian",
    "overview": "An airy dailyhousehold ledger with soft green and white liquid glass. Rounded translucent surfaces, readable financial amounts, and quiet outlined icons make everyday recording approachable. The balance supports the working transaction area without turning the screen into a stack of dashboard cards.\n\nThis is the approved replacement visual world from image 2, extracted from the implemented application. The reference composition adapts to real household values and logical phone dimensions; it is not a claim of pixel reproduction. The automated hero comparison remains open/failed at 59.2. Documentation does not close that gate.",
    "keyCharacteristics": [
      "Soft green and white translucent material.",
      "Fully rounded containers and capsule actions.",
      "Airy lists with readable amounts and metadata.",
      "One self-hosted sans family and Lucide outline icons."
    ],
    "rules": [
      {
        "name": "The Quiet Material Rule",
        "body": "Use green-white surfaces for structure; reserve stronger color for actions, selection, and financial meaning.",
        "section": "colors"
      }
    ],
    "dos": [
      "**Do** use soft green-white glass, rounded surfaces, and outlined icons consistently across screens and sheets.",
      "**Do** keep real amounts readable with tabular numerals and reserve clearance for the floating dock.",
      "**Do** preserve live values and loading, error, empty, selected, and keyboard-focus states."
    ],
    "donts": [
      "**Don't** add nested dashboard cards, promotional badges, or decorative AI motifs to the daily ledger.",
      "**Don't** reintroduce the former dark teal visual identity or desktop sidebar as the default system.",
      "**Don't** describe reference comparison, authentication migration, or storage setup as complete without independent evidence."
    ]
  }
}
